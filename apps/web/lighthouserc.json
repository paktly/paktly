{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=3101 pnpm start",
      "startServerReadyPattern": "Ready in|ready - started server|Local:",
      "url": ["http://localhost:3101/", "http://localhost:3101/features", "http://localhost:3101/privacy", "http://localhost:3101/security"],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox --headless --disable-gpu" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/reports" }
  }
}
