api.paktly.io {
    encode zstd gzip

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    reverse_proxy api:4000 {
        health_uri /api/v1/ready
        health_interval 30s
        health_timeout 5s
        lb_try_duration 5s
    }

    log {
        output stdout
        format json
    }
}
