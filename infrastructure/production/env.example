# Copy to /opt/paktly/.env, replace every CHANGE_ME value, then chmod 600.
NODE_ENV=production
SOCKETFI_API_URL=https://api.socket.fi
SOCKETFI_CLIENT_ID=paktly
SOCKETFI_CLIENT_SECRET=replace-with-server-only-secret
SOCKETFI_ISSUER=https://socket.fi
SOCKETFI_ORIGIN=https://socket.fi
SOCKETFI_NETWORK=TESTNET
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=https://paktly.io,https://www.paktly.io
TRUST_PROXY=loopback,linklocal,uniquelocal
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

POSTGRES_DB=paktly
POSTGRES_USER=paktly
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_URL_SAFE_REDIS_PASSWORD

PAKTLY_API_IMAGE=paktly-api
PAKTLY_HOST_API_PORT=4000
PAKTLY_ENV_FILE=/opt/paktly/.env
