# Copy to /opt/paktly/.env, replace every CHANGE_ME value, then chmod 600.
NODE_ENV=production
SOCKETFI_API_URL=https://api.socket.fi
SOCKETFI_CLIENT_ID=sf_client_live_mq2aa2w2ofwynne6gkftyendov8k
SOCKETFI_CLIENT_SECRET=replace-with-server-only-secret
SOCKETFI_ISSUER=https://socket.fi
SOCKETFI_ORIGIN=https://socket.fi
SOCKETFI_NETWORK=TESTNET
EMAIL_AUTH_ENABLED=true
EMAIL_OTP_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=hello@paktly.io
SMTP_PASSWORD=CHANGE_ME_ZOHO_APP_PASSWORD_OR_ZEPTOMAIL_SMTP_PASSWORD
EMAIL_FROM=Paktly <hello@paktly.io>
APPLE_AUTH_ENABLED=true
APPLE_CLIENT_ID=io.paktly.app
GOOGLE_AUTH_ENABLED=true
GOOGLE_SERVER_CLIENT_ID=CHANGE_ME_GOOGLE_WEB_OAUTH_CLIENT_ID
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=https://paktly.io,https://www.paktly.io
TRUST_PROXY=loopback,linklocal,uniquelocal
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

POSTGRES_DB=paktly
POSTGRES_USER=paktly
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_URL_SAFE_REDIS_PASSWORD

PAKTLY_API_IMAGE=paktly-api
PAKTLY_HOST_API_PORT=4000
PAKTLY_ENV_FILE=/opt/paktly/.env
